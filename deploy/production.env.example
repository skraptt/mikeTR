# mikeTR canlı ortam ayarları.
#
#   cp deploy/production.env.example deploy/production.env
#
# deploy/production.env git'e girmez. İçindeki anahtarlar müvekkil verisine
# erişim sağlar; dosyayı yalnızca sunucuda tutun ve kimseyle paylaşmayın.
# "openssl rand -hex 32" yazan her satır için ayrı bir rastgele değer üretin.

# --- Alan adı ve HTTPS -----------------------------------------------------
# Uygulamanın adresi (https:// olmadan). DNS A kaydı bu sunucuyu göstermeli.
DOMAIN=mevzuat.example.com
# Let's Encrypt'in sertifika bildirimlerini göndereceği e-posta.
ACME_EMAIL=you@example.com
# Arayüz dili: tr veya en.
NEXT_PUBLIC_DEFAULT_LOCALE=tr

# --- Supabase (canlı proje; test projesini kullanmayın) ---------------------
# Supabase > Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Dosya depolama (Cloudflare R2 veya başka bir S3 uyumlu servis) -------
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=miketr

# --- Gizli anahtarlar (her biri için: openssl rand -hex 32) ---------------
DOWNLOAD_SIGNING_SECRET=
USER_API_KEYS_ENCRYPTION_SECRET=
MCP_CONNECTORS_ENCRYPTION_SECRET=
# Dışa aktarılan proje arşivlerini imzalar. Boş bırakılırsa imzasız olur.
MANIFEST_SIGNING_KEY=

# --- Yapay zekâ modelleri ---------------------------------------------------
# En az bir sağlayıcı gerekli. Müvekkil verisi bu sağlayıcılara gider:
# veri işleme sözleşmesi olan ve veriyi eğitimde kullanmayan sağlayıcıları
# seçin (KVKK md. 9). Kullanıcılar kendi anahtarlarını Ayarlar'dan da ekleyebilir.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# --- Mevzuat ----------------------------------------------------------------
# Güncelleme önerilerini onaylayabilecek e-postalar (virgülle ayrılmış).
KANUN_ADMIN_EMAILS=
# mevzuat.gov.tr ile karşılaştırma aralığı (saat). 0 kapatır.
KANUN_SYNC_INTERVAL_HOURS=24

# --- Mike iş akışı kataloğu --------------------------------------------------
# Tekrarlanabilir kurulum için bir commit SHA'sı sabitleyin.
MIKE_WORKFLOWS_REPOSITORY=skraptt/mike-workflows-tr
MIKE_WORKFLOWS_REF=main

# --- Açık olmaması gerekenler -----------------------------------------------
# Kullanıcıların iş akışlarını Mike'ın açık kaynak deposuna göndermesini sağlar.
WORKFLOW_CONTRIBUTIONS_ENABLED=false
