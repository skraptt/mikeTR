# Server-only upstream used by the same-origin /api gateway.
API_BASE_URL=http://localhost:3001

# Sentry error tracking is OFF BY DEFAULT in mikeTR. Set your own DSNs, or
# *_DISABLED=false to report to the upstream Mike project's US-hosted Sentry
# (README "Telemetri", docs/observability.md): never document text,
# bodies, cookies, auth headers or emails; community installs also drop
# machine names, user ids, headers, breadcrumbs and file paths. NEXT_PUBLIC_*
# values are inlined into the browser bundle at build time; the SENTRY_*
# ones are read by the Next server at runtime.
NEXT_PUBLIC_SENTRY_DISABLED=true
NEXT_PUBLIC_SENTRY_INSTALL=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_DISABLED=true
SENTRY_INSTALL=
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
# Source-map upload for readable production stack traces; all three required.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Interface language: en (default) or tr. Strings without a translation
# fall back to English. See src/shared/i18n.
NEXT_PUBLIC_DEFAULT_LOCALE=en
